<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions: model files live in the app's own storage, and an imported file comes through the system picker. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="ggtts demo">
        <!-- configChanges: a fold, unfold or rotation keeps the activity, so a render in progress reports to it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
