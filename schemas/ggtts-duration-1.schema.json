{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ggtts:schema:ggtts-duration:1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "path", "chunks", "discarded_draws_included", "output_sample_rate", "output_samples", "output_seconds", "join_samples", "join_seconds", "text_decoded_samples", "text_decoded_seconds", "rate_note"],
  "properties": {
    "format": {"const": "ggtts-duration/1"}, "path": {"enum": ["text", "story"]}, "rate_note": {"type": "string"},
    "instruction": {"description": "The request's style instruction (ggtts-render --instruction), when it had a non-empty one; absent otherwise. Added within this format version: a document without it is still valid.", "type": "string", "minLength": 1},
    "sampling": {"description": "The Qwen3-TTS sampler settings, frame cap and language the load was given (load.temperature and the rest, by their name in the load section); a setting not given is the engine's default and is absent. Absent when none was given. Added within this format version: a document without it is still valid.", "type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"temperature": {"type": "number", "exclusiveMinimum": 0}, "top_k": {"type": "integer", "minimum": 0}, "top_p": {"type": "number", "minimum": 0}, "repetition_penalty": {"type": "number", "exclusiveMinimum": 0}, "subtalker_temperature": {"type": "number", "exclusiveMinimum": 0}, "subtalker_top_k": {"type": "integer", "minimum": 0}, "subtalker_top_p": {"type": "number", "minimum": 0}, "max_frames": {"type": "integer", "minimum": 1}, "language": {"enum": ["auto", "en", "ru", "zh", "ja", "ko", "de", "fr", "es", "it", "pt"]}}},
    "kitten_full_head": {"description": "Kitten-TTS 2 computed its whole output head (load.kitten_full_head, GGTTS_KITTEN_FULL_HEAD), not only the rows a step can sample. Absent when it did not. Added within this format version: a document without it is still valid.", "const": true},
    "steer": {"description": "The render's steering (ggtts-render --steer): the steering file's sha256, the talker layers a vector was added at, and the scale. Absent for an unsteered render. Added within this format version: a document without it is still valid.", "type": "object", "additionalProperties": false, "required": ["sha256", "layers", "scale"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}}, "scale": {"type": "number"}}},
    "models": {"description": "Every model file the render used: a default file from the cache by its verified pinned sha256, a path given on the command line by the sha256 of its content. Added within this format version: a document without it is still valid.", "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256", "source", "url"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source": {"enum": ["cache", "path"]}, "url": {"description": "Where a cached file was fetched from; null for a given path.", "type": ["string", "null"], "minLength": 1}}, "if": {"properties": {"source": {"const": "cache"}}}, "then": {"properties": {"url": {"type": "string"}}}, "else": {"properties": {"url": {"type": "null"}}}}},
    "discarded_draws_included": {"const": false},
    "output_sample_rate": {"$ref": "#/$defs/optional_count"}, "output_samples": {"$ref": "#/$defs/count"},
    "output_seconds": {"$ref": "#/$defs/optional_number"}, "join_samples": {"$ref": "#/$defs/optional_count"},
    "join_seconds": {"$ref": "#/$defs/optional_number"}, "text_decoded_samples": {"$ref": "#/$defs/optional_count"},
    "text_decoded_seconds": {"$ref": "#/$defs/optional_number"},
    "chunks": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["chunk", "kept_draw", "sample_rate", "decoded_samples", "decoded_seconds", "trimmed_samples", "trimmed_seconds"],
      "properties": {"chunk": {"$ref": "#/$defs/count"}, "kept_draw": {"$ref": "#/$defs/count"},
        "sample_rate": {"$ref": "#/$defs/optional_count"}, "decoded_samples": {"$ref": "#/$defs/count"},
        "decoded_seconds": {"$ref": "#/$defs/optional_number"}, "trimmed_samples": {"$ref": "#/$defs/count"},
        "trimmed_seconds": {"$ref": "#/$defs/optional_number"}}}}]}
  },
  "$defs": {"count": {"type": "integer", "minimum": 0}, "optional_count": {"type": ["integer", "null"], "minimum": 0},
    "optional_number": {"type": ["number", "null"], "minimum": 0}}
}
