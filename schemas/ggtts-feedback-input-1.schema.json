{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "ggtts-feedback-input/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "string",
            "pattern": "^data:audio/flac;base64,[A-Za-z0-9+/]+={0,2}$"
          }
        },
        "required": [
          "id",
          "text",
          "audio"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "id",
    "items"
  ],
  "additionalProperties": false
}
