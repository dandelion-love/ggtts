{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "ggtts-feedback-result/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "marks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "rating": {
            "enum": [
              "accept",
              "reject",
              "unsure"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "marks",
          "rating",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "id",
    "items",
    "note",
    "input_sha256"
  ],
  "additionalProperties": false
}
