{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ggtts:schema:ggtts-timing:1",
  "title": "ggtts-timing/1: one completed render's timing boundaries",
  "description": "models was added within ggtts-timing/1: a report without it is still valid, and one with it is still ggtts-timing/1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "engine", "backend", "parity", "load_ms", "render_ms", "audio_seconds",
    "frames_generated", "stages", "render_rtf", "stream", "trace_sink", "artifact_write_ns",
    "instrument_phase_ms", "logging", "limits"],
  "properties": {
    "format": {"const": "ggtts-timing/1"},
    "engine": {"type": "string"}, "backend": {"type": "string"}, "parity": {"type": "string"},
    "load_ms": {"$ref": "#/$defs/count"}, "render_ms": {"$ref": "#/$defs/count"},
    "audio_seconds": {"$ref": "#/$defs/optional_number"}, "frames_generated": {"$ref": "#/$defs/count"},
    "render_rtf": {"$ref": "#/$defs/optional_number"},
    "artifact_write_ns": {"$ref": "#/$defs/optional_count"},
    "instrument_phase_ms": {"$ref": "#/$defs/optional_count"},
    "stages": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["generate_ns", "decode_ns", "judge_ns", "generated_frames_per_second"],
      "properties": {"generate_ns": {"$ref": "#/$defs/count"}, "decode_ns": {"$ref": "#/$defs/count"},
        "judge_ns": {"$ref": "#/$defs/optional_count"}, "generated_frames_per_second": {"$ref": "#/$defs/optional_number"}}}]},
    "stream": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["first_audio_ms", "writes", "preparation_ns", "write_ns"],
      "properties": {"first_audio_ms": {"$ref": "#/$defs/optional_count"}, "writes": {"$ref": "#/$defs/count"},
        "preparation_ns": {"$ref": "#/$defs/optional_count"}, "write_ns": {"$ref": "#/$defs/count"}}}]},
    "trace_sink": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["level", "events", "sink_ns", "flush_ns"],
      "properties": {"level": {"enum": [1, 2]}, "events": {"$ref": "#/$defs/count"},
        "sink_ns": {"$ref": "#/$defs/count"}, "flush_ns": {"$ref": "#/$defs/count"}}}]},
    "logging": {"type": "object", "additionalProperties": false,
      "required": ["level", "format", "records", "sink_ns", "lock_wait_ns"],
      "properties": {"level": {"enum": ["error", "warn", "info", "debug", "trace"]},
        "format": {"enum": ["text", "json"]}, "records": {"$ref": "#/$defs/count"},
        "sink_ns": {"$ref": "#/$defs/count"}, "lock_wait_ns": {"$ref": "#/$defs/count"}}},
    "limits": {"type": "string", "minLength": 1},
    "models": {"description": "Every model file the render used: a default file from the cache by its verified pinned sha256, a path given on the command line by the sha256 of its content.",
      "type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["role", "path", "sha256", "source", "url"],
      "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"enum": ["cache", "path"]},
        "url": {"description": "Where a cached file was fetched from; null for a given path.", "type": ["string", "null"], "minLength": 1}},
      "if": {"properties": {"source": {"const": "cache"}}}, "then": {"properties": {"url": {"type": "string"}}},
      "else": {"properties": {"url": {"type": "null"}}}}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "optional_count": {"type": ["integer", "null"], "minimum": 0},
    "optional_number": {"type": ["number", "null"], "minimum": 0}
  }
}
